@model HotelLasTerrazas.Web.Models.LoginModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card p-4">
            <h3 class="mb-3 text-center">Iniciar sesión</h3>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                </div>
            }

            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    @Html.TextBox("NombreUsuario", Model?.NombreUsuario, new { @class = "form-control", placeholder = "Tu usuario" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    @Html.Password("Password", null, new { @class = "form-control", placeholder = "••••••••" })
                </div>

                <button type="submit" class="btn btn-success w-100">Ingresar</button>
            }

            <p class="text-center mt-3 mb-0">
                ¿No tienes cuenta? @Html.ActionLink("Regístrate aquí", "Registro", "Account")
            </p>
        </div>
    </div>
</div>
