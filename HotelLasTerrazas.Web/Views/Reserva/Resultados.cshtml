@model System.Collections.Generic.IEnumerable<HotelLasTerrazas.Web.Models.HabitacionDisponible>
@{
    ViewBag.Title = "Habitaciones disponibles";
}

<h3 class="mb-4">Habitaciones disponibles</h3>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        No hay habitaciones disponibles para las fechas seleccionadas.
        @Html.ActionLink("Volver a buscar", "Buscar", "Reserva", null, new { @class = "alert-link" })
    </div>
}
else
{
    @using (Html.BeginForm("Confirmar", "Reserva", FormMethod.Post))
    {
        <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
            @foreach (var h in Model)
            {
                <div class="col">
                    <div class="card p-3 h-100">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="habitacionesSeleccionadas" value="@h.IdHabitacion" id="hab_@h.IdHabitacion" />
                            <label class="form-check-label fw-bold" for="hab_@h.IdHabitacion">
                                Habitación @h.NumeroHabitacion
                            </label>
                        </div>
                        <p class="mb-1 mt-2">@h.NombreTipo</p>
                        <p class="mb-1 text-muted">Capacidad: @h.Capacidad personas</p>
                        <p class="mb-0 fs-5 text-success">S/ @h.PrecioNoche.ToString("0.00") / noche</p>
                    </div>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-success">Confirmar reserva</button>
        @Html.ActionLink("Volver a buscar", "Buscar", "Reserva", null, new { @class = "btn btn-outline-secondary ms-2" })
    }
}
